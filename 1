const getFormattedDate = () => {
  const date = new Date();
  const weeks = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
  const month = date.getMonth() + 1;
  const day = date.getDate();
  const week = weeks[date.getDay()];
  return { full: `${date.getFullYear()}年${month}月${day}日`, month, day, week };
};

