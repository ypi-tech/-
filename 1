const ImgWithFallback = ({ src, alt, className }) => {
  const [status, setStatus] = useState('loading'); 
  const fallbacks = [
    "https://images.unsplash.com/photo-1547592166-23ac45744acd?auto=format&fit=crop&q=80&w=600",
    "https://images.unsplash.com/photo-1576092768241-dec231879fc3?auto=format&fit=crop&q=80&w=600",
    "https://images.unsplash.com/photo-1605294522770-55e4293fbb13?auto=format&fit=crop&q=80&w=600",
    "https://images.unsplash.com/photo-1511690078903-71dc5a49f5e3?auto=format&fit=crop&q=80&w=600",
    "https://images.unsplash.com/photo-1548943487-a2e4f43bbcc5?auto=format&fit=crop&q=80&w=600"
  ];
  const fallbackIndex = alt ? alt.length % fallbacks.length : 0;
  const fallbackSrc = fallbacks[fallbackIndex];

  useEffect(() => {
    setStatus('loading');
    const timer = setTimeout(() => {
      setStatus(prev => prev === 'loading' ? 'error' : prev);
    }, 15000); 
    return () => clearTimeout(timer);
  }, [src]);

  return (
    <div className={`relative overflow-hidden bg-[#F6F5F3] ${className}`}>
      {status === 'loading' && (
         <div className="absolute inset-0 flex flex-col items-center justify-center bg-[#F6F5F3] z-10">
            <RefreshCw size={20} className="animate-spin text-[#45937B] opacity-50 mb-2" />
            <span className="text-[10px] font-serif text-[#45937B] opacity-50 tracking-widest mt-2">布置真实餐盘中...</span>
         </div>
      )}
      <img 
        src={status === 'error' ? fallbackSrc : src} 
        alt={alt} 
        className={`w-full h-full object-cover transition-opacity duration-700 ${status === 'loading' ? 'opacity-0' : 'opacity-100'}`}
        onLoad={() => setStatus('loaded')}
        onError={() => setStatus('error')}
      />
    </div>
  );
};


