      {filtered.length === 0 && searchTerm && (
        <div className="bg-white/80 p-8 text-center border border-dashed border-[#D2AD78] mb-8 animate-in slide-in-from-top-4">
          <p className="text-sm opacity-60 font-serif mb-4">未见记载「{searchTerm}」，是否查阅云端智库？</p>
          <button onClick={handleCloudSearch} disabled={isSearching} className="px-6 py-2 border border-[#45937B] text-[#45937B] font-bold font-serif hover:bg-[#45937B] hover:text-white transition-all">
            {isSearching ? '智库查询中...' : '联网查阅'}
