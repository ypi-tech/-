        <h3 className="text-4xl font-black font-serif leading-[1.6] mb-20 writing-vertical-rl mx-auto h-64 tracking-[0.3em]">{qs[step].q}</h3>
        <div className="grid grid-cols-2 gap-4">
          {['未曾', '偶尔', '时常', '总是'].map(o => (
            <button key={o} onClick={()=>step < qs.length-1 ? setStep(step+1) : onComplete(qs[step].type)} className="py-5 bg-white border border-[#D2AD78]/50 font-serif tracking-widest font-bold shadow-sm active:bg-[#F6F5F3] active:scale-95 transition-all rounded-xl">{o}</button>
          ))}
        </div>
      </div>
    </div>
  );
};

const NavItem = ({ active, icon, label, onClick }) => (
  <button onClick={onClick} className={`flex flex-col items-center gap-1.5 p-2 w-[58px] transition-all relative ${active ? 'text-[#45937B]' : 'text-[#8D8D8D]'}`}>
    <div className={`transition-transform duration-500 ${active ? '-translate-y-1 scale-110' : ''}`}>{icon}</div>
    <span className={`text-[10px] font-serif font-bold tracking-widest transition-all ${active ? 'opacity-100 scale-105' : 'opacity-60'}`}>{label}</span>
    {active && <div className="absolute bottom-0 w-1 h-1 bg-[#AD4B3C] rounded-full"></div>}
  </button>
);

const App = () => {
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [userProfile, setUserProfile] = useState({ username: '健康探索者', avatar: null });
  const [currentPage, setCurrentPage] = useState('home');
  const [userConstitution, setUserConstitution] = useState(null);
  const [selectedRecipe, setSelectedRecipe] = useState(null);
  const [searchTerm, setSearchTerm] = useState('');
  const [recipes, setRecipes] = useState(INITIAL_RECIPES);
  const [communityRecipes, setCommunityRecipes] = useState(INITIAL_COMMUNITY_RECIPES);
  const [plannedMeals, setPlannedMeals] = useState([]);
  const [favorites, setFavorites] = useState([]);
  const [encyclopedia, setEncyclopedia] = useState(INITIAL_ENCYCLOPEDIA);

  if (!isLoggedIn) return <AuthView onLogin={() => setIsLoggedIn(true)} />;

  const handleToggleFavorite = (recipe) => {
    if (favorites.find(f => f.id === recipe.id)) {
      setFavorites(favorites.filter(f => f.id !== recipe.id));
    } else {
      setFavorites([...favorites, recipe]);
    }
  };

  const handlePublishRecipe = (newRecipe) => {
    setCommunityRecipes([{ ...newRecipe, author: userProfile.username, id: Date.now() }, ...communityRecipes]);
  };

  return (
    <div className="min-h-screen font-sans flex flex-col max-w-md mx-auto relative pb-20 shadow-2xl overflow-hidden bg-[#F6F5F3]" style={{ backgroundImage: PAPER_TEXTURE, color: COLORS.textMain }}>
      <div className="h-3 w-full flex items-center bg-[#231717] z-20 relative">
        <div className="h-1 flex-1 mx-2" style={{ backgroundColor: COLORS.secondary, opacity: 0.5 }}></div>
      </div>
      <BackgroundWatermark />
      <main className="flex-1 overflow-y-auto custom-scrollbar relative z-10">
        {currentPage === 'home' && <HomeView userConstitution={userConstitution} currentTerm={SOLAR_TERMS[0]} recipes={recipes} setRecipes={setRecipes} onOpenTest={() => setCurrentPage('test')} onOpenRecipe={(r) => { setSelectedRecipe(r); setCurrentPage('detail'); }} />}
        {currentPage === 'test' && <TestView onComplete={(res) => { setUserConstitution(res); setCurrentPage('home'); }} onBack={() => setCurrentPage('home')} />}
        {currentPage === 'detail' && <RecipeDetailView recipe={selectedRecipe} onBack={() => setCurrentPage('home')} onAdd={(r) => {if(!plannedMeals.find(p=>p.id===r.id)) setPlannedMeals([...plannedMeals, r]); setCurrentPage('plan');}} isAdded={plannedMeals.some(r => r.id === selectedRecipe?.id)} onFavorite={handleToggleFavorite} isFavorited={favorites.some(f => f.id === selectedRecipe?.id)} />}
        {currentPage === 'encyclopedia' && <EncyclopediaView searchTerm={searchTerm} setSearchTerm={setSearchTerm} encyclopedia={encyclopedia} setEncyclopedia={setEncyclopedia} />}
        {currentPage === 'community' && <CommunityView communityRecipes={communityRecipes} onOpenRecipe={(r) => { setSelectedRecipe(r); setCurrentPage('detail'); }} onPublish={handlePublishRecipe} />}
        {currentPage === 'plan' && <PlanView plannedMeals={plannedMeals} favorites={favorites} onRemove={(id) => setPlannedMeals(plannedMeals.filter(r => r.id !== id))} onOpenRecipe={(r) => { setSelectedRecipe(r); setCurrentPage('detail'); }} />}
        {currentPage === 'profile' && <ProfileView userConstitution={userConstitution} onRetest={() => setCurrentPage('test')} userProfile={userProfile} setUserProfile={setUserProfile} />}
      </main>
      <nav className="absolute bottom-0 w-full backdrop-blur-xl border-t flex justify-between items-center pt-2 pb-5 px-3 z-50 rounded-t-3xl bg-white/95 border-[#D2AD78]/30 shadow-[0_-5px_20px_rgba(0,0,0,0.03)]">
        <NavItem active={currentPage === 'home'} icon={<CalendarIcon size={20} />} label="时令" onClick={() => setCurrentPage('home')} />
        <NavItem active={currentPage === 'encyclopedia'} icon={<BookOpen size={20} />} label="本草" onClick={() => setCurrentPage('encyclopedia')} />
        <NavItem active={currentPage === 'community'} icon={<Compass size={20} />} label="雅集" onClick={() => setCurrentPage('community')} />
        <NavItem active={currentPage === 'plan'} icon={<Leaf size={20} />} label="调养" onClick={() => setCurrentPage('plan')} />
        <NavItem active={currentPage === 'profile'} icon={<User size={20} />} label="我的" onClick={() => setCurrentPage('profile')} />
      </nav>
    </div>
  );
};

export default App;
