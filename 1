// --- API Helpers ---

const fetchCloudHerb = async (herbName) => {
  const apiKey = ""; 
  const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
  const prompt = `你是一个资深中药学专家。请查询中药材或食材【${herbName}】的信息。请务必返回JSON格式对象，含name, nature, taste, channel, effect, forbidden字段。不要输出Markdown代码块，直接输出JSON。`;
  try {
    const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }], generationConfig: { responseMimeType: "application/json" } } ) });
    const data = await response.json();
    return JSON.parse(data.candidates[0].content.parts[0].text);
  } catch (e) { throw new Error("库查询失败"); }
};

const fetchCloudRecipes = async (constitutionName, termName) => {
  const apiKey = ""; 
  const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
  const prompt = `你是一个资深中医食疗专家。请根据节气【${termName}】和体质【${constitutionName}】，推荐2个全新的真实养生食谱。
  请务必返回JSON数组格式，每个对象含: title, englishTitle(用于生图的准确英文名), tags(数组), constitution(设为"${constitutionName}"), energy(温/平/凉), time, ingredients(数组含name和amount对象), steps(数组), benefit 字段。不要输出Markdown代码块。`;
  try {
    const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }], generationConfig: { responseMimeType: "application/json" } }) });
    const data = await response.json();
    const parsed = JSON.parse(data.candidates[0].content.parts[0].text);
    return parsed.map(r => ({ ...r, id: Date.now() + Math.random(), image: getRecipeImage(r.title, r.englishTitle) }));
  } catch (e) { 
    console.error("Fetch Cloud Recipes Error:", e);
    throw new Error("数据库失败"); 
  }
};

