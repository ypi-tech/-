const EncyclopediaView = ({ searchTerm, setSearchTerm, encyclopedia, setEncyclopedia }) => {
  const [isSearching, setIsSearching] = useState(false);
  const filtered = (encyclopedia || []).filter(h => h.name && h.name.includes(searchTerm || ''));

  const handleCloudSearch = async () => {
    if (!searchTerm) return;
    setIsSearching(true);
    try {
      const newHerb = await fetchCloudHerb(searchTerm);
      if (!encyclopedia.find(h => h.name === newHerb.name)) setEncyclopedia([newHerb, ...encyclopedia]);
    } catch (e) { console.error(e); } finally { setIsSearching(false); }
  };

  return (
    <div className="p-6 pb-24 h-full relative z-10">
      <header className="mb-8 pt-4"><h2 className="text-3xl font-bold font-serif tracking-widest">本草寻根</h2></header>
